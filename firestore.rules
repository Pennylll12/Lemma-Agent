rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function manager() {
      return signedIn() && role() == 'manager';
    }

    function cs() {
      return signedIn() && (role() == 'manager' || role() == 'cs');
    }

    // Customer Master writes happen only through server-side Admin SDK services.
    match /customers/{customerId} {
      allow read: if cs();
      allow write: if false;
    }

    match /conversations/{conversationId} {
      allow read: if cs();
      allow write: if false;
    }

    match /customerEvents/{eventId} {
      allow read: if cs();
      allow write: if false;
    }

    match /aiAnalysis/{analysisId} {
      allow read: if manager();
      allow write: if false;
    }

    match /syncState/{stateId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
