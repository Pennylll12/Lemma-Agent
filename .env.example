# Lark application credentials
LARK_APP_ID=cli_your_lark_app_id
LARK_APP_SECRET=your_lark_app_secret

# OpenAI API credential for the optional local skill runner
OPENAI_API_KEY=sk-your_openai_api_key

# Firebase Admin SDK. For local development use a service-account JSON string;
# production should use its platform's workload identity or secret store instead.
FIREBASE_PROJECT_ID=lemma-customerdata
FIREBASE_SERVICE_ACCOUNT_JSON=

# SleekFlow Platform API. Set SLEEKFLOW_PROXY_URL for a local HTTP CONNECT proxy.
SLEEKFLOW_API_BASE_URL=https://api.sleekflow.io
SLEEKFLOW_API_KEY=
SLEEKFLOW_PROXY_URL=http://127.0.0.1:7897
